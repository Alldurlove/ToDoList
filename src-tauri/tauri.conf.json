{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToDoList",
  "version": "0.1.0",
  "identifier": "com.example.todolist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToDoList",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.svg"
    ]
  }
}
